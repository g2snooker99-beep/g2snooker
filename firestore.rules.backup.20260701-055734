rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /pointTransactions/{transactionId} {
      allow read: if true;
      allow create: if true;
    }

    match /seasonResults/{seasonId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /latestNotifications/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /monthlyRewardSummaries/{summaryId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
